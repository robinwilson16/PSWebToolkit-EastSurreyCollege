        }

        .cky-optout-success {
            width: 798px;
            max-width: 100%;
            border-radius: 8px;
            padding: 8px 12px;
            margin: 0 auto;
            box-sizing: border-box;
            outline: none
        }

            .cky-optout-success .cky-optout-success-inner {
                display: flex;
                flex-direction: column;
                gap: 4px
            }

            .cky-optout-success .cky-optout-success-row {
                display: flex;
                align-items: flex-start
            }

            .cky-optout-success .cky-optout-success-icon {
