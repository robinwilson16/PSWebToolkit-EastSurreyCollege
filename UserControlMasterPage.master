        }

            .cky-consent-bar .cky-banner-btn-close img {
                height: 9px;
                width: 9px;
                margin: 0;
            }

        .cky-notice-group {
            font-size: 14px;
            line-height: 24px;
            font-weight: 400;
            color: #212121;
        }

        .cky-notice-btn-wrapper .cky-btn-do-not-sell {
            font-size: 14px;
            line-height: 24px;
            padding: 6px 0;
