 <%--   <script src="https://www.osc.ac.uk/wp-content/themes/C4/assets/js/homepage.js"></script>--%>
    <script>
        document.addEventListener(
            "DOMContentLoaded", () => {
                menu = new Mmenu("#menud", {
                    offCanvas: {
                        position: "right"
                    },
                    navbar: {
                        title: "Menu"
                    },
                    navbars: [
                        {
                            position: "top",
                            content: [
                                "close"
                            ]
                        }
                    ]
                }, {
                    offCanvas: {
                        page: {
                            selector: "#mmPage"
                        }
                    }
                });

                api = menu.API;
                api.bind("open:before",
                    () => {
                        window.scrollTo(0, 0);
                        $('body').removeClass("mobileMenuInUse").addClass("mobileMenuInUse");
                    }
                );
                api.bind("close:after",
                    () => {
                        setTimeout("$('body').removeClass('mobileMenuInUse');", 400);
                    }
                );

              

                $('.mm-panel').each(function () {
                    $(this).addClass($(this).find('ul:first').data('menuClass'));
                });

                $('#menu-item-1924').addClass('colour-scheme-16-18');
                $('#menu-item-1925').addClass('colour-scheme-apprenticeships');
                $('#menu-item-1933').addClass('colour-scheme-adults');
                $('#menu-item-1934').addClass('colour-scheme-higher-education');
                $('#menu-item-1941').addClass('colour-scheme-send');

            }
        );



</script>
    <script src="https://www.osc.ac.uk/wp-content/themes/C4/assets/js/parallax-elements.js"></script>
    <script src="https://www.osc.ac.uk/wp-content/themes/C4/assets/js/ticker.js"></script>


    <script>
        $(document).ready(function () {
            $('.sliderImages').slick({
                fade: true,
                arrows: true,
                dots: false,
                asNavFor: '.sliderText',
                autoplay: true,
                autoplaySpeed: 5000
            });
            $('.sliderText').slick({
                arrows: false,
                fade: true,
                dots: false,
                asNavFor: '.sliderImages',
                autoplay: true,
                autoplaySpeed: 5000
            });
            $('button#pause').on('click', function () {
                $('.sliderImages').slick('slickPause');
                $('.sliderText').slick('slickPause');
                $(this).hide();
                $('button#play').show();
            });
            $('button#play').on('click', function () {
                $('.sliderImages').slick('slickPlay');
                $('.sliderText').slick('slickPlay');
                $(this).hide();
                $('button#pause').show();
            });

        });

</script>






    <script>

        $(".ugb-video-popup__wrapper").click(function () {
            if (typeof gtag === "function") {
                gtag('event', 'video_' + $(this).data("video"));
            }
            else if (typeof ga === "function") {
                ga('send', {
                    hitType: 'event',
                    eventCategory: 'Video_' + $(this).data("video"),
                    eventAction: 'play',
                    eventLabel: $(this).data("video")
                });
            }
        });

</script>
    <script>				
        document.addEventListener('DOMContentLoaded', function () {
            setTimeout(function () {
                if (document.querySelectorAll('[name^=ct_checkjs]').length > 0) {
                    if (typeof apbct_public_sendREST === 'function' && typeof apbct_js_keys__set_input_value === 'function') {
                        apbct_public_sendREST(
                            'js_keys__get',
                            { callback: apbct_js_keys__set_input_value })
                    }
                }
            }, 0)
        })
                </script>
