        /* */
        .video-next:before,
        .video-prev:before {
            position: absolute;
            z-index: 300;
            height: 60px;
            width: 60px;
            top: 0;
            border: none;
            font-size: 0;
            outline: none;
            appearance: none;
            padding: 0;
        }

        .video-prev:before {
            left: 0;
        }


        .video-next:before,
        .video-prev:before {
            font-family: "Font Awesome 6 Free";
            font-weight: 700;
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            right: 0;
            width: 100%;
            height: 100%;
            line-height: 60px;
            text-align: center;
            color: #fff;
            font-size: 1.125rem;
        }

        .video-next:before {
            content: "\f061";
        }

        .video-prev:before {
            content: "\f060";
        }

        .video-next {
            right: 0;
        }

        .video-next,
        .video-prev {
            background: transparent;
            border: none;
            position: absolute;
            z-index: 300;
            height: 60px;
            width: 60px;
            top: calc(50% + 60px);
            border: none;
            font-size: 0;
            outline: none;
            appearance: none;
            padding: 0;
        }



            .video-next:before,
            .video-prev:before {
                -webkit-transition: all 0.2s ease;
                -moz-transition: all 0.2s ease;
                -ms-transition: all 0.2s ease;
                -o-transition: all 0.2s ease;
                transition: all 0.2s ease;
                background-color: #000000;
                color: #fff;
            }


            .video-next:hover:before,
            .video-prev:hover:before {
                background-color: #FAA926;
                color: #000000;
            }


        @media (max-width: 767px) {

            .video-next, .video-prev {
                height: 40px;
                width: 40px;
                top: auto;
                bottom: 0;
                margin-top: 0;
            }


                .video-next:before, .video-prev:before {
                    line-height: 40px;
                }
        }


        @media (min-width: 768px) and (max-width: 1023px) {
            .video-next, .video-prev {
