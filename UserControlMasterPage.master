    <style>
        body .perfmatters-lazy-css-bg:not([data-ll-status=entered]), body .perfmatters-lazy-css-bg:not([data-ll-status=entered]) *, body .perfmatters-lazy-css-bg:not([data-ll-status=entered])::before, body .perfmatters-lazy-css-bg:not([data-ll-status=entered])::after, body .perfmatters-lazy-css-bg:not([data-ll-status=entered]) *::before, body .perfmatters-lazy-css-bg:not([data-ll-status=entered]) *::after {
