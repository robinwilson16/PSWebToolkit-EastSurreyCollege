        .cky-accordion-item .cky-accordion-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .cky-accordion-header .cky-accordion-btn {
            font-size: 16px;
            font-family: inherit;
            color: #212121;
            line-height: 24px;
            background: none;
            border: none;
            font-weight: 700;
            padding: 0;
            margin: 0;
            cursor: pointer;
            text-transform: none;
            min-height: 0;
            text-shadow: none;
            box-shadow: none;
        }

        .cky-accordion-header .cky-always-active {
