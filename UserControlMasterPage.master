        .cky-btn-reject {
            color: #1863dc;
            background: transparent;
            border: 2px solid #1863dc;
        }

        .cky-btn-accept {
            background: #1863dc;
            color: #ffffff;
            border: 2px solid #1863dc;
        }

        .cky-btn:last-child {
            margin-right: 0;
        }

        @media (max-width: 576px) {
            .cky-box-bottom-left {
                bottom: 0;
