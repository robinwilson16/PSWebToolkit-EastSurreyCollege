    <script>
        function getCookiePopup(name) {
            var dc = document.cookie;
            var prefix = name + "=";
            var begin = dc.indexOf("; " + prefix);
            if (begin == -1) {
                begin = dc.indexOf(prefix);
                if (begin != 0) return null;
            }
            else {
                begin += 2;
                var end = document.cookie.indexOf(";", begin);
                if (end == -1) {
                    end = dc.length;
                }
            }
            // because unescape has been deprecated, replaced with decodeURI
            //return unescape(dc.substring(begin + prefix.length, end));
            return decodeURI(dc.substring(begin + prefix.length, end));
        }
        function setCookiePopup(name, value, daysToLive) {
            // Encode value in order to escape semicolons, commas, and whitespace
            var cookie = name + "=" + encodeURIComponent(value);

            if (typeof daysToLive === "number") {
                /* Sets the max-age attribute so that the cookie expires
                after the specified number of days */
                cookie += ";path=/;max-age=" + (daysToLive * 24 * 60 * 60);

                document.cookie = cookie;
            }
        }


        popupItems = [];
        currentPopupShowing = 0;
        $(document).ready(function () {

            htmlCode = '';

            itemsPos = 0;



            drawpopupbox();

        });

        function drawpopupbox() {
            if (popupItems.length != 0) {



                theButtons = {};

                if (popupItems[currentPopupShowing]["show_link"]) {

                    theButtons.viewmore = {
                        text: popupItems[currentPopupShowing]["title"], btnClass: 'btn-more', action: function () {
                            if (popupItems[currentPopupShowing]["target"] == "_blank") {
                                window.open(popupItems[currentPopupShowing]["url"]);
                            }
                            else {
                                window.location = popupItems[currentPopupShowing]["url"];
                            }


                        }
                    };

                }


                theButtons.close = { text: "Close", btnClass: 'btn-close' };


                cookieName = "popup_" + popupItems[currentPopupShowing]["cfpopupid"];

                if (popupItems[currentPopupShowing]["often"] == "once") {
                    if (getCookiePopup(cookieName) == null) {
                        setCookiePopup(cookieName, "1", 90);
                    }

                }

                $.confirm({
                    title: '',
                    backgroundDismiss: true,
                    content: popupItems[currentPopupShowing]["content"],
                    theme: 'modern',
                    animation: 'scale',
                    type: 'red',
                    containerFluid: true,
                    buttons: theButtons
                });




            }
        }


    </script>
    <script>

        function getCookiSlideIn(name) {
            var dc = document.cookie;
            var prefix = name + "=";
            var begin = dc.indexOf("; " + prefix);
            if (begin == -1) {
                begin = dc.indexOf(prefix);
                if (begin != 0) return null;
            }
            else {
                begin += 2;
                var end = document.cookie.indexOf(";", begin);
                if (end == -1) {
                    end = dc.length;
                }
            }
            // because unescape has been deprecated, replaced with decodeURI
            //return unescape(dc.substring(begin + prefix.length, end));
            return decodeURI(dc.substring(begin + prefix.length, end));
        }
        function setCookieSlideIn(name, value, daysToLive) {
            // Encode value in order to escape semicolons, commas, and whitespace
            var cookie = name + "=" + encodeURIComponent(value);

            if (typeof daysToLive === "number") {
                /* Sets the max-age attribute so that the cookie expires
                after the specified number of days */
                cookie += ";path=/;max-age=" + (daysToLive * 24 * 60 * 60);

                document.cookie = cookie;
            }
        }


        function loadNotifications() {


        }

        $(document).ready(function () {
            setTimeout('loadNotifications()', 1000)
        });
</script>





