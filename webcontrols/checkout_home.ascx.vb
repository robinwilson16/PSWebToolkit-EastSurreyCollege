    Public Overrides Sub ValidateControl()
        If Not chkConfirm.Checked Then
            Dim v As New CustomValidator
            v.IsValid = False
            v.ErrorMessage = "Please accept the policies"
            Me.Page.Validators.Add(v)
        End If
    End Sub

    Protected Sub btnGetStarted_click(ByVal sender As Object, ByVal e As EventArgs) Handles getstarted.Click
        Me.Page.Validate()

        If Me.Page.IsValid Then
            Response.Redirect(GetResourceValue("directapply_aspx") & "&OfferingID=" & Me.OfferingID)
        End If
    End Sub
