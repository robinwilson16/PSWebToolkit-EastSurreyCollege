    Protected Overrides Sub OnLoad(ByVal e As System.EventArgs)
        MyBase.OnLoad(e)

        Session("RequestMode") = RequestMode.ApplicationRequest

        If Not IsPostBack Then
            PutAllOfferingsInBasket()
        End If
    End Sub

    Private Function GetFieldObject(instance As Object, propertyName As String) As Object
        Try
            Return CallByName(instance, propertyName, CallType.Get)
        Catch
            Return Nothing
        End Try
    End Function

    Private Function ConvertToInteger(value As Object) As Integer
        If value Is Nothing OrElse DBNull.Value.Equals(value) Then
            Return 0
        End If

        Try
            Return CInt(value)
        Catch
        End Try

        Try
            Return CInt(CallByName(value, "Value", CallType.Get))
        Catch
        End Try

        Return 0
    End Function

    Private Function GetOfferingFieldValue(instance As Object, propertyName As String) As String
        Dim value As Object = GetFieldObject(instance, propertyName)
        If value Is Nothing OrElse DBNull.Value.Equals(value) Then
            Return String.Empty
        End If

        Try
            Return CStr(value).Trim()
        Catch
            Return String.Empty
        End Try
    End Function

    Private Function GetOfferingFieldInteger(instance As Object, propertyName As String) As Integer
        Return ConvertToInteger(GetFieldObject(instance, propertyName))
    End Function

    Private Function GetBasketItemType(websiteAvailabilityId As Integer) As String
        Select Case websiteAvailabilityId
            Case 2
                Return "Application"
            Case 4
                Return "Enquiry"
            Case Else
                Return "Enrolment"
        End Select
    End Function

    Protected Sub PutAllOfferingsInBasket()
        Dim IntOffering1ID As Integer = Me.Offering1ID
        If IntOffering1ID <> -1 Then
            Dim tblOffering1 As New OfferingDataTable
            Dim v As CCCDataViewDataSet = CCCDataViewDataSet.CreateDataView(tblOffering1)
            v.Columns.AddPKColumns()
            v.Columns.EnsureColumnsAreSelected(True, False, tblOffering1.WebSiteAvailabilityIDColumn, tblOffering1.OfferingIDColumn, tblOffering1.CourseInformationIDColumn, tblOffering1.TotalFeeAmountColumn, tblOffering1.OfferingTypeIDColumn, tblOffering1.CollegeLevelUserDefined1Column)
            v.Filters.SetColumnFilter(tblOffering1.OfferingIDColumn, IntOffering1ID)
            tblOffering1.TableAdapter.Load(tblOffering1, v)

            If tblOffering1.Count > 0 AndAlso tblOffering1(0).WebSiteAvailabilityID.HasValue Then
                Dim item As New ShoppingCartItem()
                With tblOffering1(0)
                    item.Cost = 0
                    item.Description = .GetRowDescription
                    item.ItemType = "Application"
                    item.OfferingID = .OfferingID.Value
                    item.CourseInfoID = .CourseInformationID.GetValueOrDefault
                End With
                With WorkingData.ShoppingCart
                    If Not .Items.Contains(item) Then
                        .Items.Add(item)
                    End If
                End With
            End If
        End If

